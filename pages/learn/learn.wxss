.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #FFFFF0;
}

.header {
  text-align: center;
  padding: 40rpx 0;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.header-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #FFC107;
  color: #333;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.add-icon {
  font-size: 36rpx;
}

.add-text {
  font-size: 30rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item {
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  margin-bottom: 16rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.item-time {
  font-size: 24rpx;
  color: #999;
}

.item-delete {
  font-size: 28rpx;
  color: #CCC;
  padding: 8rpx;
}

.item-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}

.empty-desc {
  font-size: 26rpx;
  color: #CCC;
  margin-top: 12rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal {
  width: 80%;
  background: #FFF;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  width: 100%;
  height: 200rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-btns {
  margin-top: 32rpx;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.modal-btn.cancel {
  background: #F5F5F5;
  color: #666;
}

.modal-btn.confirm {
  background: #FFC107;
  color: #333;
}
