<view class="page">
  <view class="header">
    <view class="header-title">📚 学学好</view>
    <view class="header-desc">看到对方好习惯，记下来跟着学</view>
  </view>

  <view class="add-btn" bindtap="showAdd">
    <text class="add-icon">+</text>
    <text class="add-text">记录好习惯</text>
  </view>

  <view class="list" wx:if="{{items.length > 0}}">
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="item-header flex-between">
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-time">{{item.date}} {{item.time}}</text>
        </view>
        <view class="item-delete" bindtap="deleteItem" data-id="{{item.id}}">✕</view>
      </view>
      <view class="item-content">{{item.content}}</view>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-icon">📚</view>
    <view class="empty-text">还没有记录</view>
    <view class="empty-desc">发现对方的好习惯就记下来吧</view>
  </view>

  <!-- 添加弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" catchtap="noop">
    <view class="modal" catchtap="noop">
      <view class="modal-title">📚 记录好习惯</view>
      <textarea class="modal-input" placeholder="写下对方的好习惯..." value="{{newContent}}" bindinput="onContentInput" auto-focus maxlength="500" />
      <view class="modal-btns flex-row">
        <view class="modal-btn cancel" bindtap="hideModal">取消</view>
        <view class="modal-btn confirm" bindtap="addItem">记录</view>
      </view>
    </view>
  </view>
</view>
