<view class="page">
  <!-- 空状态 -->
  <view class="empty" wx:if="{{whispers.length === 0}}">
    <text class="empty-emoji">💌</text>
    <text class="empty-text">还没有悄悄话哦～</text>
    <text class="empty-sub">给对方写一句悄悄话吧</text>
  </view>

  <!-- 悄悄话列表 -->
  <view class="whisper-list">
    <block wx:for="{{whispers}}" wx:key="id">
      <!-- 时间分割线 -->
      <view wx:if="{{item.showTime}}" class="time-divider">
        <text class="time-divider-text">{{item.time}}</text>
      </view>
      <!-- 消息气泡 -->
      <view class="msg-row {{item.isMine ? 'mine' : 'theirs'}}">
        <view class="msg-bubble">
          <text class="msg-content">{{item.content}}</text>
        </view>
        <text class="msg-sender">{{item.sender}}</text>
      </view>
    </block>
  </view>

  <view style="height: 140rpx;"></view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <view class="input-wrap flex-row">
      <input
        class="whisper-input"
        placeholder="说句悄悄话…"
        value="{{inputText}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="sendWhisper"
        maxlength="200"
      />
      <view class="send-btn flex-center" bindtap="sendWhisper">
        <text>发送</text>
      </view>
    </view>
  </view>
</view>
