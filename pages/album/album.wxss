.page { padding: 20rpx 24rpx; min-height: 100vh; }

/* ===== 相册列表 ===== */
.section-title { font-size: 32rpx; font-weight: 700; color: #333; margin-bottom: 16rpx; }

.album-list { display: flex; flex-direction: column; gap: 16rpx; }

.album-card {
  background: #FFF; border-radius: 20rpx; padding: 20rpx;
  display: flex; align-items: center; gap: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.06);
}
.album-card:active { background: #FFF5F5; }

.album-cover {
  width: 120rpx; height: 120rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #FFF0F3, #FFE4E1);
  flex-shrink: 0; overflow: hidden;
}
.cover-img { width: 100%; height: 100%; }
.cover-emoji { font-size: 52rpx; }

.album-info { flex: 1; overflow: hidden; }
.album-name { font-size: 30rpx; font-weight: 600; color: #333; }
.album-desc { font-size: 24rpx; color: #999; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.album-meta { font-size: 22rpx; color: #BBB; margin-top: 6rpx; }

.album-arrow { font-size: 36rpx; color: #DDD; flex-shrink: 0; }

/* ===== 照片视图 ===== */
.photo-header { margin-bottom: 12rpx; }
.back-btn { font-size: 28rpx; color: #FF6B8A; padding: 8rpx; }
.back-arrow { font-size: 40rpx; margin-right: 4rpx; line-height: 1; }
.photo-album-name { font-size: 30rpx; font-weight: 600; color: #333; }

.album-desc-bar {
  background: #FFF; border-radius: 12rpx; padding: 16rpx 20rpx;
  margin-bottom: 16rpx; font-size: 26rpx; color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.photo-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }

.photo-item {
  background: #FFF; border-radius: 16rpx; overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.06);
}
.photo-wrap { width: 100%; height: 340rpx; position: relative; overflow: hidden; }
.photo-wrap .photo-img { width: 100%; height: 100%; }
.photo-wrap .photo-emoji { font-size: 64rpx; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #FFF5F5; }

.photo-desc-row { padding: 12rpx 14rpx; }
.photo-desc-text { font-size: 24rpx; color: #555; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.photo-date-text { font-size: 22rpx; color: #BBB; flex-shrink: 0; margin-left: 8rpx; }

/* ===== 照片预览（支持缩放） ===== */
.preview-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.95); z-index: 200;
  display: flex; flex-direction: column;
}
.preview-close {
  position: absolute; top: 60rpx; right: 30rpx;
  color: #FFF; font-size: 40rpx; z-index: 210;
  width: 60rpx; height: 60rpx; display: flex;
  align-items: center; justify-content: center;
}
.preview-movable-area {
  flex: 1; width: 100%;
}
.preview-movable-view {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
}
.preview-img { width: 100%; height: 80vh; }
.preview-bottom {
  background: rgba(0,0,0,0.6); padding: 20rpx 24rpx;
  max-height: 40vh;
}
.preview-info { text-align: center; color: #FFF; margin-bottom: 16rpx; }
.preview-desc { font-size: 28rpx; display: block; margin-bottom: 4rpx; }
.preview-date { font-size: 22rpx; opacity: 0.6; }

/* 评论 */
.comment-list { max-height: 200rpx; margin-bottom: 12rpx; }
.comment-item { padding: 8rpx 0; }
.comment-by { font-size: 22rpx; color: #FFB6C1; margin-right: 8rpx; }
.comment-text { font-size: 24rpx; color: #EEE; }
.comment-input-row { gap: 12rpx; align-items: center; }
.comment-input {
  flex: 1; background: rgba(255,255,255,0.15); border-radius: 24rpx;
  padding: 14rpx 24rpx; font-size: 26rpx; color: #FFF;
}
.comment-input::placeholder { color: rgba(255,255,255,0.5); }
.comment-send {
  color: #FFB6C1; font-size: 26rpx; font-weight: 500; padding: 14rpx 8rpx;
}

/* ===== 空状态 ===== */
.empty { padding: 100rpx 0; text-align: center; display: flex; flex-direction: column; align-items: center; }
.empty-emoji { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; color: #CCC; }
.empty-sub { font-size: 26rpx; color: #DDD; margin-top: 8rpx; }

/* ===== FAB ===== */
.add-fab {
  position: fixed; bottom: 80rpx; right: 40rpx;
  width: 96rpx; height: 96rpx;
  background: linear-gradient(135deg, #FF6B8A, #FF85A2);
  border-radius: 50%; box-shadow: 0 8rpx 24rpx rgba(255,107,138,0.4);
  z-index: 10;
}
.fab-icon { font-size: 48rpx; color: #FFF; font-weight: 300; line-height: 1; }
.add-fab:active { transform: scale(0.9); opacity: 0.85; }

/* ===== 弹窗 ===== */
.overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); display: flex;
  align-items: center; justify-content: center; z-index: 100;
}
.modal-card { background: #FFF; border-radius: 24rpx; padding: 36rpx 28rpx; width: 560rpx; }
.modal-title { font-size: 30rpx; font-weight: 600; color: #333; text-align: center; margin-bottom: 24rpx; }

.form-row { display: flex; align-items: center; margin-bottom: 18rpx; }
.form-label { width: 120rpx; font-size: 26rpx; color: #666; flex-shrink: 0; }
.form-input { flex: 1; background: #F8F8F8; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; }
.form-textarea { flex: 1; background: #F8F8F8; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; min-height: 120rpx; width: 100%; box-sizing: border-box; }

.modal-btns { gap: 12rpx; margin-top: 8rpx; }
.mbtn { flex: 1; padding: 22rpx 0; border-radius: 16rpx; text-align: center; font-size: 28rpx; font-weight: 500; }
.mbtn.cancel { background: #F5F5F5; color: #999; }
.mbtn.confirm { background: linear-gradient(135deg, #FF6B8A, #FF85A2); color: #FFF; }

/* 照片选择 */
.photo-preview-box {
  width: 100%; height: 280rpx; border-radius: 16rpx;
  background: #F8F8F8; border: 2rpx dashed #DDD;
  margin-bottom: 20rpx; overflow: hidden;
}
.photo-preview-img { width: 100%; height: 100%; }
.photo-preview-placeholder { font-size: 28rpx; color: #CCC; }
