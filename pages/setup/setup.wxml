<view class="page">
  <!-- 首次设置：开发者密钥 -->
  <view wx:if="{{step === 'dev_key'}}">
    <view class="welcome-area">
      <text class="welcome-emoji">💕</text>
      <text class="welcome-title">琳浪小栈</text>
      <text class="welcome-sub">专属我们的小宇宙</text>
    </view>

    <view class="setup-form">
      <view class="form-title">请输入密钥</view>
      <view class="form-desc">首次使用需要开发者密钥进行初始化</view>
      <input
        class="key-input"
        type="password"
        placeholder="请输入密钥"
        value="{{inputKey}}"
        bindinput="onKeyInput"
        maxlength="20"
      />
      <view class="key-hint" wx:if="{{keyError}}">{{keyError}}</view>
      <view class="btn-primary" bindtap="verifyDevKey">验证</view>
      <view class="btn-secondary" bindtap="showBindInput">我有邀请码（对方设备）</view>
    </view>
  </view>

  <!-- 开发者恢复：输入邀请码找回空间 -->
  <view wx:if="{{step === 'dev_recover'}}">
    <view class="welcome-area">
      <text class="welcome-emoji">🔍</text>
      <view class="welcome-title">找回情侣空间</view>
      <view class="welcome-sub">未自动找到你的空间，请输入邀请码恢复</view>
    </view>

    <view class="setup-form">
      <view wx:if="{{devRecoverCode}}" style="text-align:center;margin-bottom:30rpx;">
        <view style="font-size:24rpx;color:#999;margin-bottom:12rpx;">上次缓存的邀请码</view>
        <view class="invite-code-area" style="display:inline-block;">
          <text class="invite-code">{{devRecoverCode}}</text>
        </view>
      </view>

      <view class="form-title" style="margin-top:20rpx;">输入邀请码恢复</view>
      <input
        class="key-input invite-input"
        placeholder="请输入6位邀请码"
        value="{{devRecoverCode}}"
        bindinput="onDevRecoverCodeInput"
        maxlength="6"
      />
      <view class="key-hint" wx:if="{{devRecoverError}}">{{devRecoverError}}</view>
      <view class="btn-primary {{devRecoverLoading ? 'disabled' : ''}}" bindtap="confirmDevRecover">
        {{devRecoverLoading ? '恢复中...' : '恢复空间 💕'}}
      </view>
      <view class="btn-secondary" bindtap="findOldSpaces">🔍 查找我的旧空间</view>
      <view class="btn-secondary" bindtap="skipToNewSetup">跳过，创建新空间</view>

      <!-- 旧空间列表 -->
      <view wx:if="{{showOldSpaces}}" class="old-spaces-section">
        <view class="old-spaces-title">找到 {{oldSpaces.length}} 个旧空间</view>
        <view wx:if="{{oldSpacesLoading}}" class="old-spaces-loading">查找中...</view>
        <view wx:elif="{{oldSpaces.length === 0}}" class="old-spaces-empty">没有找到旧空间</view>
        <view wx:else class="old-spaces-list">
          <view class="old-space-item" wx:for="{{oldSpaces}}" wx:key="_id" bindtap="restoreOldSpace" data-couple="{{item}}">
            <view class="old-space-header flex-between">
              <view class="old-space-names">{{item.devName || '未命名'}} {{item.userName ? '& ' + item.userName : ''}}</view>
              <view class="old-space-code">邀请码: {{item.inviteCode}}</view>
            </view>
            <view class="old-space-info">
              <text wx:if="{{item.togetherDate}}">在一起: {{item.togetherDate}}</text>
              <text wx:if="{{item.userName}}" class="old-space-partner"> · 已绑定: {{item.userName}}</text>
              <text wx:else class="old-space-partner"> · 等待绑定</text>
            </view>
            <view class="old-space-hint">点击恢复此空间</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 设置情侣信息（开发者输入自己的名字和性别） -->
  <view wx:if="{{step === 'setup_info'}}">
    <view class="welcome-area small">
      <text class="welcome-emoji">💝</text>
      <text class="welcome-title">设置你的信息</text>
    </view>

    <view class="setup-form">
      <view class="form-item">
        <view class="form-label">我的名字</view>
        <input class="form-input" placeholder="输入你的名字" value="{{myName}}" bindinput="onMyName" maxlength="10" />
      </view>

      <view class="form-item">
        <view class="form-label">性别</view>
        <view class="gender-row flex-row">
          <view class="gender-option {{myGender === 'male' ? 'selected' : ''}}" bindtap="selectMyGender" data-gender="male">
            <text class="gender-emoji">🧑</text>
            <text class="gender-label">男</text>
          </view>
          <view class="gender-option {{myGender === 'female' ? 'selected' : ''}}" bindtap="selectMyGender" data-gender="female">
            <text class="gender-emoji">👩</text>
            <text class="gender-label">女</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">💕 在一起的日子</view>
        <picker mode="date" value="{{togetherDate}}" bindchange="onDateChange">
          <view class="form-input picker-input">{{togetherDate || '选择日期'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <view class="form-label">🔒 应用锁（可选）</view>
        <view class="lock-switch flex-between">
          <text>开启应用锁</text>
          <switch checked="{{lockEnabled}}" bindchange="onLockSwitch" color="#FF6B8A" />
        </view>
        <input
          wx:if="{{lockEnabled}}"
          class="form-input mt-20"
          type="password"
          placeholder="设置4位数字密码"
          value="{{lockPin}}"
          bindinput="onLockPin"
          maxlength="4"
        />
      </view>

      <view class="btn-primary" bindtap="finishSetup">完成设置 💕</view>
    </view>
  </view>

  <!-- 等待对方绑定（创建者看到） -->
  <view wx:if="{{step === 'bind_wait'}}">
    <view class="welcome-area">
      <text class="welcome-emoji">💌</text>
      <text class="welcome-title">{{myName}}{{partnerName ? ' & ' + partnerName : ''}}</text>
      <text class="welcome-sub">{{bindCreating ? '正在创建情侣空间...' : (bindCreateError ? '创建失败' : '情侣空间已创建')}}</text>
    </view>

    <view class="setup-form bind-form">
      <view wx:if="{{bindCreating}}" style="text-align:center;padding:40rpx 0;">
        <view style="font-size:48rpx;margin-bottom:20rpx;">⏳</view>
        <view style="color:#999;font-size:26rpx;">正在连接云端，请稍候...</view>
      </view>

      <view wx:elif="{{bindCreateError}}" style="text-align:center;padding:40rpx 0;">
        <view style="font-size:48rpx;margin-bottom:20rpx;">😢</view>
        <view class="key-hint">{{bindCreateError}}</view>
        <view class="btn-primary" bindtap="retryCreateCouple">重试</view>
        <view class="btn-secondary" bindtap="resetToDevKey">重新输入密钥</view>
      </view>

      <view wx:else>
        <view class="form-title">邀请码</view>
        <view class="form-desc">把这个邀请码发给TA，输入后即可绑定</view>

        <view class="invite-code-area">
          <text class="invite-code">{{inviteCode}}</text>
        </view>

        <view class="bind-hint">对方打开小程序后选择「我有邀请码」输入即可</view>

        <view class="btn-primary" bindtap="skipBind">跳过，直接进入</view>
        <view class="btn-secondary" bindtap="showBindInput">我有邀请码（对方设备）</view>
        <view class="btn-secondary" bindtap="resetToDevKey">重新设置</view>
      </view>
    </view>
  </view>

  <!-- 输入邀请码 + 自己的名字和性别（加入者看到） -->
  <view wx:if="{{step === 'bind_input'}}">
    <view class="welcome-area">
      <text class="welcome-emoji">💕</text>
      <text class="welcome-title">加入情侣空间</text>
      <text class="welcome-sub">输入对方给你的邀请码</text>
    </view>

    <view class="setup-form">
      <view class="form-item">
        <view class="form-label">我的名字</view>
        <input class="form-input" placeholder="输入你的名字" value="{{bindName}}" bindinput="onBindNameInput" maxlength="10" />
      </view>

      <view class="form-item">
        <view class="form-label">性别</view>
        <view class="gender-row flex-row">
          <view class="gender-option {{bindGender === 'male' ? 'selected' : ''}}" bindtap="selectBindGender" data-gender="male">
            <text class="gender-emoji">🧑</text>
            <text class="gender-label">男</text>
          </view>
          <view class="gender-option {{bindGender === 'female' ? 'selected' : ''}}" bindtap="selectBindGender" data-gender="female">
            <text class="gender-emoji">👩</text>
            <text class="gender-label">女</text>
          </view>
        </view>
      </view>

      <view class="form-title" style="margin-top:30rpx;">输入邀请码</view>
      <input
        class="key-input invite-input"
        placeholder="请输入6位邀请码"
        value="{{bindCode}}"
        bindinput="onBindCodeInput"
        maxlength="6"
      />
      <view class="key-hint" wx:if="{{bindError}}">{{bindError}}</view>
      <view class="btn-primary {{bindLoading ? 'disabled' : ''}}" bindtap="confirmBind">
        {{bindLoading ? '绑定中...' : '绑定 💕'}}
      </view>
      <view class="btn-secondary" bindtap="showBindWait">返回</view>
    </view>
  </view>

  <!-- 绑定已失效（使用者看到） -->
  <view wx:if="{{step === 'bind_invalid'}}">
    <view class="welcome-area">
      <text class="welcome-emoji">😢</text>
      <text class="welcome-title">绑定已失效</text>
      <text class="welcome-sub">对方已重置绑定信息，请与对方联系获取最新邀请码</text>
    </view>

    <view class="setup-form">
      <view class="btn-primary" bindtap="reBind">重新输入邀请码</view>
    </view>
  </view>

  <!-- 重新连接（使用者已有名字，恢复绑定） -->
  <view wx:if="{{step === 'rebind'}}">
    <view class="welcome-area">
      <text class="welcome-emoji">💕</text>
      <text class="welcome-title">重新连接</text>
      <text class="welcome-sub">输入之前的邀请码恢复你们的情侣空间</text>
    </view>

    <view class="setup-form">
      <view class="form-title" wx:if="{{lastInviteCode}}">你的邀请码</view>
      <view class="invite-code-area" wx:if="{{lastInviteCode}}" style="margin-bottom:30rpx;">
        <text class="invite-code">{{lastInviteCode}}</text>
      </view>

      <view class="form-title" style="margin-top:30rpx;">输入邀请码</view>
      <input
        class="key-input invite-input"
        placeholder="请输入6位邀请码"
        value="{{rebindCode}}"
        bindinput="onRebindCodeInput"
        maxlength="6"
      />
      <view class="key-hint" wx:if="{{rebindError}}">{{rebindError}}</view>
      <view class="btn-primary {{rebindLoading ? 'disabled' : ''}}" bindtap="confirmRebind">
        {{rebindLoading ? '恢复中...' : '恢复连接 💕'}}
      </view>
      <view class="btn-secondary" bindtap="showFullBindInput">输入新的邀请码</view>
    </view>
  </view>

  <!-- 日常解锁 -->
  <view wx:if="{{step === 'unlock'}}">
    <view class="welcome-area">
      <text class="welcome-emoji">🔐</text>
      <text class="welcome-title">{{myName}}{{partnerName ? ' & ' + partnerName : ''}}</text>
      <text class="welcome-sub">输入密码打开你们的小世界</text>
    </view>

    <view class="unlock-area">
      <view class="pin-dots flex-center">
        <view class="pin-dot {{pinInput.length >= 1 ? 'filled' : ''}}"></view>
        <view class="pin-dot {{pinInput.length >= 2 ? 'filled' : ''}}"></view>
        <view class="pin-dot {{pinInput.length >= 3 ? 'filled' : ''}}"></view>
        <view class="pin-dot {{pinInput.length >= 4 ? 'filled' : ''}}"></view>
      </view>
      <view class="pin-error" wx:if="{{pinError}}">{{pinError}}</view>

      <view class="num-pad">
        <view class="num-row flex-row" wx:for="{{numRows}}" wx:key="*this">
          <view
            class="num-key flex-center {{cell === '' ? 'empty' : ''}}"
            wx:for="{{item}}" wx:key="*this" wx:for-item="cell"
            bindtap="onNumTap" data-num="{{cell}}"
          >
            <text wx:if="{{cell !== ''}}">{{cell}}</text>
          </view>
        </view>
      </view>

      <view class="unlock-actions flex-between">
        <text class="action-link" bindtap="showDevReset">开发者重置</text>
        <text class="action-link" bindtap="deletePin">删除</text>
      </view>
    </view>
  </view>

  <!-- 开发者重置弹窗 -->
  <view class="overlay" wx:if="{{showDevModal}}" bindtap="hideDevModal">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">🔧 开发者重置</view>
      <view class="modal-desc">输入开发者密钥以重置应用</view>
      <input class="key-input" type="password" placeholder="开发者密钥" value="{{devResetKey}}" bindinput="onDevResetKey" maxlength="20" />
      <view class="key-hint" wx:if="{{devResetError}}">{{devResetError}}</view>
      <view class="modal-btns flex-row" style="margin-top: 20rpx;">
        <view class="mbtn cancel" bindtap="hideDevModal">取消</view>
        <view class="mbtn confirm warn" bindtap="confirmDevReset">确认重置</view>
      </view>
    </view>
  </view>
</view>
