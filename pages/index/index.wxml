<view class="page">
  <!-- 顶部日期 & 在一起天数 -->
  <view class="header-card">
    <view class="date-row flex-between">
      <view class="date-text">{{dateStr}}</view>
      <view class="weekday">{{weekday}}</view>
    </view>
    <view class="days-row flex-center">
      <text class="heart-icon">💕</text>
      <text class="days-num">{{togetherDays}}</text>
      <text class="days-label">天</text>
    </view>
    <view class="days-sub">我们已经在一起</view>
  </view>

  <!-- 天气卡片 -->
  <view class="weather-card" wx:if="{{weather}}">
    <view class="weather-title">今天的天气</view>
    <view class="weather-partners">
      <view class="weather-person">
        <view class="weather-person-top">
          <view class="weather-person-main">
            <view class="weather-person-name">{{weather.mine.name}}</view>
            <view class="weather-person-location">{{weather.mine.location}}</view>
          </view>
          <view class="weather-person-temp">{{weather.mine.hasData ? (weather.mine.icon + ' ' + weather.mine.temp + '°') : '--'}}</view>
        </view>
        <view class="weather-person-meta">
          <view class="weather-person-range">{{weather.mine.hasData ? (weather.mine.minTemp + '° ~ ' + weather.mine.maxTemp + '°') : ''}}</view>
          <view class="weather-person-text">{{weather.mine.text}}</view>
        </view>
      </view>
      <view class="weather-divider">|</view>
      <view class="weather-person">
        <view class="weather-person-top">
          <view class="weather-person-main">
            <view class="weather-person-name">{{weather.partner.name}}</view>
            <view class="weather-person-location">{{weather.partner.location}}</view>
          </view>
          <view class="weather-person-temp">{{weather.partner.hasData ? (weather.partner.icon + ' ' + weather.partner.temp + '°') : '--'}}</view>
        </view>
        <view class="weather-person-meta">
          <view class="weather-person-range">{{weather.partner.hasData ? (weather.partner.minTemp + '° ~ ' + weather.partner.maxTemp + '°') : ''}}</view>
          <view class="weather-person-text">{{weather.partner.text}}</view>
        </view>
      </view>
    </view>
    <view class="weather-clothing flex-row" wx:if="{{weather.mine.hasData}}">
      <text class="clothing-icon">{{weather.mine.clothingIcon}}</text>
      <text class="clothing-text">{{weather.mine.clothing}}</text>
    </view>
  </view>

  <!-- 纪念日倒计时提醒 -->
  <view class="reminder-card" wx:if="{{upcomingAnniversaries.length > 0}}" bindtap="goAnniversary">
    <view class="reminder-row flex-row" wx:for="{{upcomingAnniversaries}}" wx:key="id">
      <text class="reminder-icon">{{item.icon || '💝'}}</text>
      <view class="reminder-info">
        <text class="reminder-days">{{item.daysLeft === 0 ? '就是今天' : item.daysLeft + '天后'}}</text>
        <text class="reminder-title">{{item.title}}</text>
      </view>
      <text class="reminder-arrow">›</text>
    </view>
    <view class="reminder-hint">别忘了提前准备哦～</view>
  </view>

  <!-- 每日情话 -->
  <view class="quote-card" wx:if="{{dailyQuote}}">
    <text class="quote-mark">"</text>
    <text class="quote-text">{{dailyQuote}}</text>
    <text class="quote-mark right">"</text>
  </view>

  <!-- 今日心情 -->
  <view class="mood-status-card" bindtap="goMood">
    <view class="mood-status-row flex-row">
      <view class="ms-item">
        <text class="ms-emoji" wx:if="{{todayMood}}">
          <block wx:if="{{todayMood.mood === 'happy'}}">😊</block>
          <block wx:elif="{{todayMood.mood === 'sweet'}}">🥰</block>
          <block wx:elif="{{todayMood.mood === 'calm'}}">😌</block>
          <block wx:elif="{{todayMood.mood === 'sad'}}">😢</block>
          <block wx:elif="{{todayMood.mood === 'angry'}}">😤</block>
        </text>
        <text class="ms-emoji" wx:else>😶</text>
        <text class="ms-name">{{myName}}</text>
      </view>
      <view class="ms-divider">💕</view>
      <view class="ms-item" style="position:relative;">
        <text class="ms-emoji" wx:if="{{partnerMood}}">
          <block wx:if="{{partnerMood.mood === 'happy'}}">😊</block>
          <block wx:elif="{{partnerMood.mood === 'sweet'}}">🥰</block>
          <block wx:elif="{{partnerMood.mood === 'calm'}}">😌</block>
          <block wx:elif="{{partnerMood.mood === 'sad'}}">😢</block>
          <block wx:elif="{{partnerMood.mood === 'angry'}}">😤</block>
        </text>
        <text class="ms-emoji" wx:else>😶</text>
        <text class="ms-name">{{partnerName}}</text>
        <view wx:if="{{hasNewMood}}" class="red-dot"></view>
      </view>
    </view>
    <view class="ms-hint">
      <text wx:if="{{todayMood}}">今日已打卡 ›</text>
      <text wx:else>记录今日心情 ›</text>
    </view>
  </view>

  <!-- 今日菜单区 -->
  <c-card title="今天想…" shadow="{{false}}" customStyle="background: linear-gradient(135deg, #FFF5F7, #FFEEF2);">
    <view class="today-menu flex-row">
      <view class="menu-entry" style="position:relative;" bindtap="goMenu">
        <view class="entry-icon">🍽️</view>
        <view class="entry-label">吃什么</view>
        <view wx:if="{{hasNewOrder}}" class="red-dot"></view>
      </view>
      <view class="menu-entry" style="position:relative;" bindtap="goDiary">
        <view class="entry-icon">📝</view>
        <view class="entry-label">做了什么</view>
        <view wx:if="{{hasNewDiary}}" class="red-dot"></view>
      </view>
      <view class="menu-entry" style="position:relative;" bindtap="goWhisper">
        <view class="entry-icon">💌</view>
        <view class="entry-label">想说什么</view>
        <view wx:if="{{hasNewWhisper}}" class="red-dot"></view>
      </view>
    </view>
  </c-card>

  <!-- 快捷卡片区 -->
  <view class="quick-cards flex-row">
    <view class="quick-card" bindtap="goAlbum">
      <view class="qc-icon">📸</view>
      <view class="qc-title">时光相册</view>
      <view class="qc-sub">{{albumCount}} 张回忆</view>
    </view>
    <view class="quick-card" bindtap="goAnniversary">
      <view class="qc-icon">💝</view>
      <view class="qc-title">纪念日</view>
      <view class="qc-sub">{{nextAnniversary}}</view>
    </view>
  </view>

  <view class="quick-cards flex-row" style="margin-top: 0;">
    <view class="quick-card quick-card-full" style="position:relative;" bindtap="goWishlist">
      <view class="qc-icon">✨</view>
      <view class="qc-title">愿望清单</view>
      <view class="qc-sub">{{wishCount}} 个未完成心愿</view>
      <view wx:if="{{hasNewWish}}" class="red-dot"></view>
    </view>
  </view>

  <!-- 最近动态 -->
  <c-card title="最近动态" moreText="全部" bindmore="goRecord">
    <view class="activity-list">
      <view class="activity-item flex-row" wx:for="{{activities}}" wx:key="id" wx:for-item="act">
        <view class="act-dot {{act.type}}"></view>
        <view class="act-content">
          <view class="act-text">{{act.text}}</view>
          <view class="act-time">{{act.time}}</view>
        </view>
      </view>
    </view>
  </c-card>

  <view style="height: 40rpx;"></view>
</view>
