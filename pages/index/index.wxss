.page {
  padding-bottom: 20rpx;
}

/* 顶部卡片 */
.header-card {
  background: linear-gradient(135deg, #FF6B8A 0%, #FF85A2 50%, #FFB6C1 100%);
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 138, 0.3);
}

.date-row {
  font-size: 28rpx;
  opacity: 0.9;
}

.date-text { font-size: 30rpx; }
.weekday { font-size: 26rpx; }

.days-row {
  margin-top: 24rpx;
}

.heart-icon {
  font-size: 48rpx;
  margin-right: 12rpx;
  animation: heartbeat 1.5s ease-in-out infinite;
}

@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  25% { transform: scale(1.15); }
  50% { transform: scale(1); }
  75% { transform: scale(1.15); }
}

.days-num {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.days-label {
  font-size: 36rpx;
  margin-left: 8rpx;
  opacity: 0.9;
}

.days-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.8;
  text-align: center;
}

/* 天气卡片 */
.weather-card {
  margin: 0 24rpx 16rpx;
  background: linear-gradient(135deg, #E8F4FD, #F0F8FF);
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(100, 149, 237, 0.1);
}

.weather-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #5B9BD5;
  margin-bottom: 12rpx;
}

.weather-partners {
  display: flex;
  align-items: stretch;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.weather-person {
  flex: 1;
  background: rgba(255, 255, 255, 0.62);
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
}

.weather-person-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.weather-person-main {
  flex: 1;
  min-width: 0;
}

.weather-person-name {
  font-size: 24rpx;
  color: #5B9BD5;
  font-weight: 600;
}

.weather-person-location {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.35;
  color: #7BA3CC;
}

.weather-person-temp {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #4C8ECB;
  font-weight: 700;
  line-height: 1.1;
}

.weather-person-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6rpx 10rpx;
  margin-top: 8rpx;
}

.weather-person-range {
  font-size: 18rpx;
  color: #8DB4D8;
}

.weather-person-text {
  font-size: 20rpx;
  color: #678DB5;
  line-height: 1.35;
}

.weather-divider {
  align-self: center;
  color: #B0D0E8;
  font-size: 22rpx;
}

/* 穿衣建议 */
.weather-clothing {
  background: rgba(255,255,255,0.7);
  border-radius: 12rpx;
  padding: 8rpx 14rpx;
  justify-content: center;
}

.clothing-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.clothing-text {
  font-size: 20rpx;
  color: #666;
  line-height: 1.3;
}

/* 纪念日提醒 */
.reminder-card {
  margin: 0 24rpx 16rpx;
  background: linear-gradient(135deg, #FFF8F0, #FFE8E0);
  border-radius: 20rpx; padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 152, 0, 0.08);
}
.reminder-row {
  padding: 10rpx 0; border-bottom: 1rpx solid rgba(255,152,0,0.1);
}
.reminder-row:last-child { border-bottom: none; }
.reminder-icon { font-size: 36rpx; margin-right: 14rpx; }
.reminder-info { flex: 1; }
.reminder-days { font-size: 26rpx; font-weight: 700; color: #FF6B3D; display: block; }
.reminder-title { font-size: 24rpx; color: #8B6914; margin-top: 2rpx; }
.reminder-arrow { font-size: 28rpx; color: #DDD; }
.reminder-hint {
  text-align: center; font-size: 22rpx; color: #C9A87C; margin-top: 10rpx;
}

/* 每日情话 */
.quote-card {
  margin: 0 24rpx 16rpx;
  background: linear-gradient(135deg, #FFF8F0, #FFF0E6);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(255, 165, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.quote-mark {
  font-size: 48rpx;
  color: #FFB6C1;
  font-family: Georgia, serif;
  line-height: 1;
  margin: 0 4rpx;
}

.quote-mark.right {
  align-self: flex-end;
}

.quote-text {
  font-size: 26rpx;
  color: #8B7355;
  line-height: 1.8;
  font-style: italic;
  letter-spacing: 1rpx;
}

/* 今日心情状态卡 */
.mood-status-card {
  margin: 0 24rpx 16rpx;
  background: linear-gradient(135deg, #FFF0FF, #F8F0FF);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(180, 100, 255, 0.08);
}

.mood-status-row {
  justify-content: center;
  align-items: center;
}

.ms-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ms-emoji { font-size: 48rpx; margin-bottom: 6rpx; display: block; }
.ms-name { font-size: 24rpx; color: #999; }

.ms-divider { font-size: 28rpx; opacity: 0.6; margin: 0 40rpx; }

.ms-hint {
  text-align: center;
  font-size: 24rpx;
  color: #BB88DD;
  margin-top: 12rpx;
}

/* 今日菜单区 */
.today-menu {
  justify-content: space-around;
  padding: 10rpx 0;
}

.menu-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 32rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  transition: transform 0.2s;
}

.menu-entry:active {
  transform: scale(0.95);
}

.entry-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.entry-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

/* 快捷卡片 */
.quick-cards {
  padding: 0 24rpx;
  gap: 20rpx;
}

.quick-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 138, 0.08);
  text-align: center;
}

.qc-icon { font-size: 52rpx; margin-bottom: 12rpx; }
.qc-title { font-size: 30rpx; font-weight: 600; color: #333; }
.qc-sub { font-size: 24rpx; color: #999; margin-top: 6rpx; }

.quick-card-full {
  flex: none;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx;
}

.quick-card-full .qc-icon { margin-bottom: 0; }
.quick-card-full .qc-title { margin-bottom: 0; }
.quick-card-full .qc-sub { margin-top: 0; }

/* 最近动态 */
.activity-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.activity-item:last-child { border-bottom: none; }

.act-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.act-dot.diary  { background: #FF6B8A; }
.act-dot.whisper { background: #FFB6C1; }
.act-dot.album  { background: #FF85A2; }
.act-dot.menu   { background: #FFD700; }
.act-dot.wish   { background: #87CEEB; }

.act-content { flex: 1; }

.act-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.act-time {
  font-size: 24rpx;
  color: #BBB;
  margin-top: 4rpx;
}

/* 消息提醒红点 */
.red-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 16rpx;
  height: 16rpx;
  background: #FF4D4F;
  border-radius: 50%;
  z-index: 10;
}
