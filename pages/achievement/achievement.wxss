.page { padding-top: 20rpx; }

/* 进度条 */
.ach-progress-bar {
  height: 16rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.ach-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #FF6B8A, #FFB6C1);
  transition: width 0.3s ease;
}

.ach-progress-text {
  font-size: 28rpx;
  color: #666;
  margin-top: 16rpx;
  text-align: center;
}

/* 等级统计 */
.tier-stats {
  justify-content: space-around;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F5F5F5;
}

.tier-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tier-stat-icon { font-size: 32rpx; margin-bottom: 4rpx; }
.tier-stat-num { font-size: 22rpx; color: #999; }

/* 筛选标签 */
.filter-tabs {
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  overflow-x: auto;
}

.filter-tab {
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #999;
  background: #F8F8F8;
  margin-right: 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-tab.active {
  background: linear-gradient(135deg, #FF6B8A, #FF85A2);
  color: #FFFFFF;
}

/* 成就网格 */
.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ach-item {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  position: relative;
  box-sizing: border-box;
  border: 2rpx solid #F5F5F5;
}

.ach-item.locked {
  opacity: 0.5;
  filter: grayscale(80%);
}

/* 等级解锁样式 */
.ach-item.unlocked.tier-bronze {
  border-color: #DEB887;
  background: linear-gradient(135deg, #FFF8F0, #FFEEDD);
  box-shadow: 0 4rpx 16rpx rgba(205, 127, 50, 0.1);
}

.ach-item.unlocked.tier-silver {
  border-color: #D3D3D3;
  background: linear-gradient(135deg, #F8F8FF, #F0F0F8);
  box-shadow: 0 4rpx 16rpx rgba(192, 192, 192, 0.15);
}

.ach-item.unlocked.tier-gold {
  border-color: #FFD700;
  background: linear-gradient(135deg, #FFFEF0, #FFF8DC);
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.15);
}

.ach-item.unlocked.tier-platinum {
  border-color: #B9F2FF;
  background: linear-gradient(135deg, #F0FFFF, #E8F8FF);
  box-shadow: 0 4rpx 16rpx rgba(0, 200, 255, 0.1);
}

.ach-tier-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 28rpx;
}

.ach-emoji {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.ach-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.ach-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.ach-tier-label {
  font-size: 20rpx;
  color: #BBB;
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: #F8F8F8;
}

.ach-item.unlocked.tier-bronze .ach-tier-label { color: #CD7F32; background: #FFF0E0; }
.ach-item.unlocked.tier-silver .ach-tier-label { color: #808080; background: #F0F0F0; }
.ach-item.unlocked.tier-gold .ach-tier-label { color: #B8860B; background: #FFFDE0; }
.ach-item.unlocked.tier-platinum .ach-tier-label { color: #008B8B; background: #E0FFFF; }
