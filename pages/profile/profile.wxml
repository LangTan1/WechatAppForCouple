<view class="page">
  <!-- 情侣信息头 -->
  <view class="profile-header">
    <view class="couple-avatars flex-center">
      <view class="avatar-wrap" bindtap="changeMyAvatar">
        <view class="avatar my-avatar flex-center">
          <image wx:if="{{myAvatar}}" src="{{myAvatar}}" mode="aspectFill" class="avatar-img" />
          <text wx:else>{{myDefaultAvatar}}</text>
        </view>
        <text class="avatar-name">{{myName || '未设置'}}</text>
        <text class="avatar-edit">📷</text>
      </view>
      <view class="heart-connector">
        <text class="heart-beat">❤️</text>
      </view>
      <view class="avatar-wrap" bindtap="changePartnerAvatar">
        <view class="avatar partner-avatar flex-center">
          <image wx:if="{{partnerAvatar}}" src="{{partnerAvatar}}" mode="aspectFill" class="avatar-img" />
          <text wx:else>{{partnerDefaultAvatar}}</text>
        </view>
        <text class="avatar-name">{{partnerName || '等待绑定'}}</text>
        <text class="avatar-edit">📷</text>
      </view>
    </view>
    <view class="days-info">
      <text>我们已经在一起</text>
      <text class="days-big">{{togetherDays}}</text>
      <text>天啦 💕</text>
    </view>
    <view class="date-info" bindtap="editTogetherDate">从 {{togetherDateStr}} 开始 ›</view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-row flex-row">
    <view class="stat-item" bindtap="goDiary">
      <view class="stat-num">{{diaryCount}}</view>
      <view class="stat-label">恋爱日记</view>
    </view>
    <view class="stat-item" bindtap="goAlbum">
      <view class="stat-num">{{photoCount}}</view>
      <view class="stat-label">时光照片</view>
    </view>
    <view class="stat-item" bindtap="goAnniversary">
      <view class="stat-num">{{anniversaryCount}}</view>
      <view class="stat-label">纪念日</view>
    </view>
  </view>

  <!-- 恋爱成就 -->
  <c-card title="恋爱成就">
    <view class="ach-summary flex-between" bindtap="goAchievement">
      <view class="ach-summary-info">
        <view class="ach-summary-num">{{unlockedCount}} 个成就已解锁</view>
        <view class="ach-badges flex-row">
          <text class="ach-badge-item" wx:if="{{badgeStats.bronze > 0}}">🥉{{badgeStats.bronze}}</text>
          <text class="ach-badge-item" wx:if="{{badgeStats.silver > 0}}">🥈{{badgeStats.silver}}</text>
          <text class="ach-badge-item" wx:if="{{badgeStats.gold > 0}}">🥇{{badgeStats.gold}}</text>
          <text class="ach-badge-item" wx:if="{{badgeStats.platinum > 0}}">💎{{badgeStats.platinum}}</text>
        </view>
        <view class="ach-summary-hint">查看全部成就 ›</view>
      </view>
      <view class="ach-summary-icon">🏆</view>
    </view>
  </c-card>

  <!-- ===== 使用者模式：爱心币余额 + 充值 ===== -->
  <view wx:if="{{!isDev}}">
    <c-card title="💖 我的爱心币">
      <view class="coin-display flex-center">
        <text class="coin-big">{{coinBalance}}</text>
        <text class="coin-unit">爱心币</text>
      </view>
      <view class="recharge-btn-full" bindtap="showRecharge">💌 申请充值</view>
      <!-- 交易记录 -->
      <view wx:if="{{coinTxns.length > 0}}" class="txn-list">
        <view class="txn-item" wx:for="{{coinTxns}}" wx:key="id">
          <view class="txn-row flex-between">
            <text class="txn-desc">{{item.type === 'add' ? '+' : '-'}}{{item.amount}} 💖 {{item.by ? 'by ' + item.by : ''}}</text>
            <text class="txn-time">{{item.time}}</text>
          </view>
          <view wx:if="{{item.message}}" class="txn-msg">💬 {{item.message}}</view>
        </view>
      </view>
    </c-card>
  </view>

  <!-- ===== 开发者模式：爱心币管理 ===== -->
  <view wx:if="{{isDev}}">
    <c-card title="💖 爱心币管理">
      <view class="coin-manage">
        <view class="coin-balance-row flex-center">
          <text class="coin-balance-label">{{partnerName || '对方'}}的余额</text>
          <text class="coin-balance-num">{{coinBalance}} 💖</text>
        </view>
        <view class="coin-input-row flex-row">
          <view class="coin-mode-toggle flex-row">
            <view class="coin-mode-btn {{coinMode === 'add' ? 'active' : ''}}" bindtap="switchCoinMode" data-mode="add">增加</view>
            <view class="coin-mode-btn {{coinMode === 'sub' ? 'active' : ''}}" bindtap="switchCoinMode" data-mode="sub">减少</view>
          </view>
          <input class="coin-amount-input" type="number" placeholder="数量" value="{{coinAmount}}" bindinput="onCoinAmount" />
          <view class="coin-submit-btn" bindtap="submitCoins">{{coinMode === 'add' ? '发放' : '扣除'}}</view>
        </view>
        <input class="coin-msg-input" placeholder="留言（可选）" value="{{coinMessage}}" bindinput="onCoinMessage" maxlength="50" />
      </view>
    </c-card>

  </view>

  <!-- 设置 -->
  <c-card title="设置">
    <view class="setting-item flex-between" bindtap="editTogetherDate">
      <text>修改在一起日期</text>
      <text class="set-val">{{togetherDateStr}}</text>
      <text class="set-arrow">›</text>
    </view>
    <!-- 双方都可修改自己的昵称 -->
    <view class="setting-item flex-between" bindtap="editMyNameFn">
      <text>修改我的昵称</text>
      <text class="set-arrow">›</text>
    </view>
    <view class="setting-item flex-between">
      <text>应用锁</text>
      <switch checked="{{lockEnabled}}" bindchange="onLockSwitch" color="#FF6B8A" />
    </view>
    <!-- 仅开发者显示查看邀请码 -->
    <view wx:if="{{isDev}}" class="setting-item flex-between" bindtap="showInviteCode">
      <text>查看邀请码</text>
      <text class="set-arrow">›</text>
    </view>
    <!-- 仅开发者显示重新设置 -->
    <view wx:if="{{isDev}}" class="setting-item flex-between" bindtap="resetApp">
      <text>重新设置</text>
      <text class="set-arrow">›</text>
    </view>
    <!-- 使用者显示重新绑定 -->
    <view wx:if="{{!isDev}}" class="setting-item flex-between" bindtap="reBindApp">
      <text>重新绑定</text>
      <text class="set-arrow">›</text>
    </view>
  </c-card>

  <!-- 充值弹窗（使用者） -->
  <view class="overlay" wx:if="{{showRechargeModal}}" bindtap="hideRecharge">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">💖 申请充值</view>
      <view class="form-row">
        <text class="form-label">想要多少币</text>
        <input class="form-input short-input" type="number" placeholder="10" value="{{rechargeAmount}}" bindinput="onRechargeAmount" />
      </view>
      <view class="form-row">
        <text class="form-label">用什么交换</text>
        <input class="form-input" placeholder="比如：一个抱抱、按摩一次…" value="{{rechargeItem}}" bindinput="onRechargeItem" maxlength="50" />
      </view>
      <view class="modal-desc">对方看到后会决定是否批准 💌</view>
      <view class="modal-btns flex-row">
        <view class="mbtn cancel" bindtap="hideRecharge">取消</view>
        <view class="mbtn confirm" bindtap="sendRecharge">发送请求</view>
      </view>
    </view>
  </view>

  <!-- 修改在一起日期弹窗 -->
  <view class="overlay" wx:if="{{showDatePicker}}" bindtap="hideDatePicker">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">修改在一起的日子</view>
      <picker mode="date" value="{{togetherDateVal}}" bindchange="onTogetherDateChange">
        <view class="date-picker">{{togetherDateVal || '选择日期'}}</view>
      </picker>
      <view class="modal-btns flex-row" style="margin-top: 24rpx;">
        <view class="mbtn cancel" bindtap="hideDatePicker">取消</view>
        <view class="mbtn confirm" bindtap="saveTogetherDate">确定</view>
      </view>
    </view>
  </view>

  <!-- 修改昵称弹窗（仅编辑自己的名字） -->
  <view class="overlay" wx:if="{{showNameModal}}" bindtap="hideNameModal">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">修改我的昵称</view>
      <view class="form-row">
        <text class="form-label">我的名字</text>
        <input class="form-input" value="{{editMyName}}" bindinput="onEditMyName" maxlength="10" />
      </view>
      <view class="modal-btns flex-row">
        <view class="mbtn cancel" bindtap="hideNameModal">取消</view>
        <view class="mbtn confirm" bindtap="saveMyName">保存</view>
      </view>
    </view>
  </view>

  <!-- 页脚 -->
  <view class="footer">
    <text>琳浪小栈 v1.0</text>
    <text class="footer-heart">Made with 💕</text>
  </view>
  <view style="height: 40rpx;"></view>
</view>
