.page {
  padding-top: 20rpx;
}

/* 新增按钮 */
.add-bar {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(135deg, #FFF5F7, #FFEEF2);
  border: 2rpx dashed #FFB6C1;
  border-radius: 20rpx;
  padding: 28rpx;
  font-size: 30rpx;
  color: #FF6B8A;
}

.add-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

/* 日记列表 */
.diary-list {
  margin: 0 24rpx;
}

.diary-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 138, 0.06);
  position: relative;
  overflow: hidden;
}

.diary-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #FF6B8A, #FFB6C1);
  border-radius: 3rpx;
}

.diary-header {
  margin-bottom: 12rpx;
}

.diary-date {
  font-size: 24rpx;
  color: #BBB;
}

.diary-mood {
  font-size: 32rpx;
}

.diary-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.diary-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #CCC;
}

.empty-sub {
  font-size: 26rpx;
  color: #DDD;
  margin-top: 8rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.modal-input {
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.modal-textarea {
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 200rpx;
  width: 100%;
  box-sizing: border-box;
}

.modal-count {
  text-align: right;
  font-size: 24rpx;
  color: #CCC;
  margin-top: 8rpx;
  display: block;
}

.modal-btns {
  margin-top: 24rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-btn.cancel {
  background: #F5F5F5;
  color: #999;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #FF6B8A, #FF85A2);
  color: #FFFFFF;
}
