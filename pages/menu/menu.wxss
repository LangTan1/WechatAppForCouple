.page { padding-bottom: 20rpx; min-height: 100vh; background: var(--bg); }

/* ===== 通用 ===== */
.coin-bar {
  margin: 24rpx;
  background: linear-gradient(135deg, #FFF0F5, #FFF5EE);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(255,107,138,0.08);
}
.coin-amount { font-size: 40rpx; font-weight: 700; color: #FF6B8A; margin: 0 8rpx; }
.coin-label { font-size: 26rpx; color: #999; }
.recharge-btn {
  background: linear-gradient(135deg, #FF6B8A, #FF85A2);
  color: #FFF; border-radius: 32rpx; padding: 12rpx 28rpx; font-size: 24rpx; font-weight: 500;
}

/* 使用者子Tab */
.user-tabs { margin: 0 24rpx 16rpx; gap: 12rpx; }
.user-tab {
  flex: 1; background: #FFF; border-radius: 16rpx; padding: 16rpx 0;
  font-size: 26rpx; color: #999; position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.user-tab.active { background: linear-gradient(135deg, #FF6B8A, #FF85A2); color: #FFF; font-weight: 600; }
.tab-badge {
  position: absolute; top: -8rpx; right: -4rpx;
  background: #FF4757; color: #FFF; font-size: 20rpx;
  min-width: 32rpx; height: 32rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
}
.random-bar { margin: 0 24rpx 20rpx; }
.random-btn {
  background: linear-gradient(135deg, #FF6B8A, #FF85A2);
  color: #FFF; border-radius: 48rpx; padding: 24rpx;
  font-size: 30rpx; font-weight: 600; width: 100%;
  box-shadow: 0 6rpx 20rpx rgba(255,107,138,0.3);
  letter-spacing: 2rpx;
}
.random-btn:active { transform: scale(0.97); opacity: 0.9; }
.random-icon { font-size: 36rpx; margin-right: 10rpx; }

/* 一级分类 */
.top-category-tabs {
  margin: 0 24rpx 12rpx; gap: 12rpx;
}
.top-cat-tab {
  flex: 1; background: #FFF; border-radius: 16rpx; padding: 18rpx 0;
  font-size: 28rpx; color: #666; font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.3s;
}
.top-cat-tab.active {
  background: linear-gradient(135deg, #FF6B8A, #FF85A2);
  color: #FFF; font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255,107,138,0.3);
}

/* 二级分类 */
.category-tabs {
  margin: 0 24rpx 16rpx; background: #FFF;
  border-radius: 20rpx; padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.cat-tab {
  flex: 1; padding: 18rpx 0; border-radius: 16rpx;
  font-size: 26rpx; color: #999; transition: all 0.3s;
}
.cat-tab.active {
  background: linear-gradient(135deg, #FF6B8A, #FF85A2);
  color: #FFF; font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255,107,138,0.3);
}

.food-list { margin: 0 24rpx; max-height: 55vh; }
.food-item {
  background: #FFF; border-radius: 20rpx; padding: 20rpx 24rpx;
  margin-bottom: 12rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  align-items: center;
}
.food-emoji { font-size: 44rpx; margin-right: 16rpx; }
.food-info { flex: 1; }
.food-name { font-size: 30rpx; color: #333; font-weight: 500; margin-bottom: 4rpx; }
.food-price { font-size: 24rpx; color: #FF6B8A; }
.price-icon { font-size: 20rpx; margin-right: 4rpx; }
.food-order-btn {
  background: linear-gradient(135deg, #FF6B8A, #FF85A2);
  color: #FFF; border-radius: 32rpx; padding: 14rpx 28rpx;
  font-size: 26rpx; font-weight: 500; flex-shrink: 0;
}
.food-order-btn:active { opacity: 0.8; }

.empty { padding: 80rpx 0; text-align: center; display: flex; flex-direction: column; align-items: center; }
.empty-emoji { font-size: 72rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: #CCC; }
.empty-sub { font-size: 24rpx; color: #DDD; margin-top: 6rpx; }

.add-bar {
  position: fixed; bottom: 0; left: 24rpx; right: 24rpx;
  background: linear-gradient(135deg, #FFF5F7, #FFEEF2);
  border: 2rpx dashed #FFB6C1; border-radius: 20rpx;
  padding: 24rpx; font-size: 28rpx; color: #FF6B8A;
  margin-bottom: 20rpx; text-align: center; z-index: 5;
}

/* ===== 弹窗通用 ===== */
.overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); display: flex;
  align-items: center; justify-content: center; z-index: 100;
}
.overlay-card {
  background: #FFF; border-radius: 24rpx; padding: 40rpx 32rpx;
  width: 560rpx; display: flex; flex-direction: column; align-items: center;
  animation: popIn 0.3s ease-out;
}
@keyframes popIn {
  0% { transform: scale(0.5); opacity: 0; }
  80% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}
.rr-emoji { font-size: 72rpx; margin-bottom: 12rpx; }
.rr-name { font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.rr-food { font-size: 36rpx; color: #FF6B8A; font-weight: 600; margin-bottom: 8rpx; }
.rr-price { font-size: 28rpx; color: #999; margin-bottom: 24rpx; }
.rr-btns { gap: 16rpx; width: 100%; }
.rr-btn { flex: 1; padding: 22rpx 0; border-radius: 16rpx; text-align: center; font-size: 28rpx; font-weight: 500; }
.rr-btn.cancel { background: #F5F5F5; color: #999; }
.rr-btn.confirm { background: linear-gradient(135deg, #FF6B8A, #FF85A2); color: #FFF; }

.order-emoji { font-size: 72rpx; margin-bottom: 12rpx; }
.order-question { font-size: 30rpx; color: #333; margin-bottom: 4rpx; }
.order-food-name { font-size: 36rpx; color: #FF6B8A; font-weight: 600; margin-bottom: 20rpx; }
.order-detail { width: 100%; justify-content: center; font-size: 28rpx; color: #666; margin-bottom: 8rpx; }
.price-text { color: #FF6B8A; font-weight: 500; }
.balance-text { color: #999; }
.order-after { font-size: 24rpx; color: #BBB; margin-bottom: 20rpx; }
.after-num { color: #FF6B8A; font-weight: 500; }
.order-no-money { margin-bottom: 20rpx; font-size: 26rpx; color: #FF6B8A; text-align: center; }

/* 添加/充值/许愿弹窗 */
.add-card { align-items: stretch; }
.add-title { font-size: 32rpx; font-weight: 600; color: #333; text-align: center; margin-bottom: 24rpx; }
.add-row { align-items: center; margin-bottom: 18rpx; }
.add-label { width: 140rpx; font-size: 26rpx; color: #666; flex-shrink: 0; }
.add-input { flex: 1; background: #F8F8F8; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; }
.add-input.short { flex: none; width: 160rpx; text-align: center; }
.add-picker { background: #F8F8F8; border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; color: #FF6B8A; }
.modal-desc-sm { font-size: 24rpx; color: #BBB; text-align: center; margin-bottom: 20rpx; }

/* ===== 开发者 Tab ===== */
.dev-tabs { margin: 16rpx 24rpx 16rpx; gap: 12rpx; }
.dev-tab {
  flex: 1; background: #FFF; border-radius: 16rpx; padding: 16rpx 0;
  font-size: 26rpx; color: #999; position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.dev-tab.active { background: #333; color: #FFD700; font-weight: 600; }
.dev-tab-badge {
  position: absolute; top: -8rpx; right: -4rpx;
  background: #FF6B8A; color: #FFF; font-size: 20rpx;
  min-width: 32rpx; height: 32rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
}

.section-title { font-size: 30rpx; font-weight: 600; color: #333; margin: 20rpx 24rpx 12rpx; }

.food-actions { gap: 8rpx; }
.fa-btn {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}
.fa-btn.edit { background: #F0F0F0; color: #666; }
.fa-btn.delete { background: #FFF0F0; color: #FF6B8A; }

/* 订单 */
.order-item {
  background: #FFF; border-radius: 20rpx; padding: 20rpx 24rpx;
  margin: 0 24rpx 12rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.order-item.done-item { opacity: 0.6; }
.order-header { margin-bottom: 12rpx; }
.order-emoji { font-size: 40rpx; margin-right: 12rpx; }
.order-food { font-size: 30rpx; font-weight: 600; color: #333; }
.order-food.done-text { text-decoration: line-through; }
.order-by { font-size: 24rpx; color: #BBB; margin-top: 2rpx; }
.order-status {
  font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 12rpx; font-weight: 500;
}
.order-status.pending { background: #FFF3E0; color: #FF9800; }
.order-status.cooking { background: #FFF0F3; color: #FF6B8A; }
.order-status.done { background: #E8F5E9; color: #4CAF50; }
.order-status.rejected { background: #F5F5F5; color: #CCC; }

.order-actions { gap: 12rpx; margin-top: 8rpx; }
.oa-btn {
  padding: 10rpx 24rpx; border-radius: 16rpx; font-size: 24rpx; font-weight: 500;
}
.oa-btn.cooking { background: #FFF0F3; color: #FF6B8A; }
.oa-btn.done { background: #E8F5E9; color: #4CAF50; }
.oa-btn.accept { background: #E8F5E9; color: #4CAF50; }
.oa-btn.reject { background: #FFF0F0; color: #FF6B8A; }
.oa-btn.confirm { background: linear-gradient(135deg, #FF6B8A, #FF85A2); color: #FFF; }

.warn-btn { background: linear-gradient(135deg, #FF4444, #FF6B6B) !important; color: #FFF; }

.reject-reason {
  margin-top: 8rpx; font-size: 24rpx; color: #FF6B8A;
  background: #FFF0F0; border-radius: 8rpx; padding: 8rpx 12rpx;
}

/* 请求 */
.request-item {
  background: #FFF; border-radius: 20rpx; padding: 20rpx 24rpx;
  margin: 0 24rpx 12rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.req-header { margin-bottom: 12rpx; }
.req-emoji { font-size: 40rpx; margin-right: 12rpx; }
.req-name { font-size: 30rpx; font-weight: 600; color: #333; }
.req-by { font-size: 24rpx; color: #BBB; margin-top: 2rpx; }
.section-row { display: flex; align-items: center; justify-content: space-between; margin: 20rpx 24rpx 12rpx; }
.section-row .section-title { margin: 0; }
.clear-btn { font-size: 24rpx; color: #FF6B8A; padding: 8rpx 16rpx; }
.clear-btn:active { opacity: 0.7; }
.clear-history {
  text-align: center; padding: 24rpx; margin-top: 20rpx;
  font-size: 26rpx; color: #CCC;
}
.clear-history:active { color: #FF6B8A; }

.req-status { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 12rpx; background: #FFF3E0; color: #FF9800; }
.req-status.done { background: #E8F5E9; color: #4CAF50; }
.req-status.reject { background: #F5F5F5; color: #CCC; }
.req-exchange { font-size: 26rpx; color: #FF6B8A; margin: 8rpx 0; font-style: italic; }
.req-actions { gap: 12rpx; margin-top: 8rpx; align-items: center; }
.req-price-input {
  width: 120rpx; background: #F8F8F8; border-radius: 12rpx;
  padding: 12rpx 16rpx; font-size: 26rpx; text-align: center;
}
