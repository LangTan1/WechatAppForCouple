.page {
  padding-top: 20rpx;
}

/* 进度 */
.progress-bar {
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B8A, #FFB6C1);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 26rpx;
  color: #999;
}

/* 心愿项 */
.wish-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
}

.wish-item:last-child {
  border-bottom: none;
}

.wish-emoji {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.wish-title {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.wish-title.done {
  color: #CCC;
  text-decoration: line-through;
}

.wish-check {
  width: 44rpx;
  height: 44rpx;
  font-size: 32rpx;
  color: #DDD;
  flex-shrink: 0;
}

.wish-check.checked {
  color: #FF6B8A;
  font-size: 28rpx;
  font-weight: 700;
}

/* 空状态 */
.empty {
  padding: 80rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #CCC;
}

/* 添加按钮 */
.add-bar {
  margin: 24rpx;
  background: linear-gradient(135deg, #FFF5F7, #FFEEF2);
  border: 2rpx dashed #FFB6C1;
  border-radius: 20rpx;
  padding: 28rpx;
  font-size: 28rpx;
  color: #FF6B8A;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  text-align: center;
}

.modal-input {
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.modal-btns {
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-btn.cancel {
  background: #F5F5F5;
  color: #999;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #FF6B8A, #FF85A2);
  color: #FFFFFF;
}
