<view class="page">
  <!-- 子模块入口 -->
  <view class="record-entries">
    <view class="record-entry flex-between" bindtap="goDiary">
      <view class="re-left flex-row">
        <view class="re-icon diary-bg">📝</view>
        <view>
          <view class="re-title">恋爱日记</view>
          <view class="re-sub">记录在一起的每一天</view>
        </view>
      </view>
      <text class="re-arrow">›</text>
    </view>

    <view class="record-entry flex-between" bindtap="goWhisper">
      <view class="re-left flex-row">
        <view class="re-icon whisper-bg">💌</view>
        <view>
          <view class="re-title">悄悄话</view>
          <view class="re-sub">只对你说的甜言蜜语</view>
        </view>
      </view>
      <text class="re-arrow">›</text>
    </view>

    <view class="record-entry flex-between" bindtap="goAlbum">
      <view class="re-left flex-row">
        <view class="re-icon album-bg">📸</view>
        <view>
          <view class="re-title">时光相册</view>
          <view class="re-sub">每一帧都是爱的回忆</view>
        </view>
      </view>
      <text class="re-arrow">›</text>
    </view>

    <view class="record-entry flex-between" bindtap="goMood">
      <view class="re-left flex-row">
        <view class="re-icon mood-bg">🌈</view>
        <view>
          <view class="re-title">每日心情</view>
          <view class="re-sub">今天你的心情如何</view>
        </view>
      </view>
      <text class="re-arrow">›</text>
    </view>

    <view class="record-entry flex-between" bindtap="goAngry">
      <view class="re-left flex-row">
        <view class="re-icon angry-bg">😤</view>
        <view>
          <view class="re-title">气气本</view>
          <view class="re-sub">给情绪一个出口，不让怨气过夜</view>
        </view>
      </view>
      <text class="re-arrow">›</text>
    </view>

    <view class="record-entry flex-between" bindtap="goReflection">
      <view class="re-left flex-row">
        <view class="re-icon reflection-bg">🤔</view>
        <view>
          <view class="re-title">醒醒贴</view>
          <view class="re-sub">把争执变成关系升级的机会</view>
        </view>
      </view>
      <text class="re-arrow">›</text>
    </view>

    <view class="record-entry flex-between" bindtap="goLearn">
      <view class="re-left flex-row">
        <view class="re-icon learn-bg">📚</view>
        <view>
          <view class="re-title">学学好</view>
          <view class="re-sub">让彼此朝更好的方向生长</view>
        </view>
      </view>
      <text class="re-arrow">›</text>
    </view>

    <view class="record-entry flex-between" bindtap="goSweet">
      <view class="re-left flex-row">
        <view class="re-icon sweet-bg">💗</view>
        <view>
          <view class="re-title">甜甜记</view>
          <view class="re-sub">储存感情存款，吵架时拿出来救急</view>
        </view>
      </view>
      <text class="re-arrow">›</text>
    </view>

    <view class="record-entry flex-between" bindtap="goAvoid">
      <view class="re-left flex-row">
        <view class="re-icon avoid-bg">⚡</view>
        <view>
          <view class="re-title">避雷贴</view>
          <view class="re-sub">写出自己的使用说明书，避免重复踩坑</view>
        </view>
      </view>
      <text class="re-arrow">›</text>
    </view>
  </view>

  <!-- 快捷入口 -->
  <c-card title="更多">
    <view class="more-entries flex-row">
      <view class="more-entry" bindtap="goAnniversary">
        <view class="me-icon">💝</view>
        <view class="me-text">纪念日</view>
      </view>
      <view class="more-entry" bindtap="goWishlist">
        <view class="me-icon">✨</view>
        <view class="me-text">愿望清单</view>
      </view>
    </view>
  </c-card>

  <view style="height: 40rpx;"></view>
</view>
